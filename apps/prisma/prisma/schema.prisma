model Post {
    id        Int     @id @default(autoincrement())
    title     String  @db.VarChar(200)
    slug      String
    content   String
    published Boolean @default(false)
    views     Int     @default(0)
    tags      Tag[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    metadata  Json?

    @@unique([slug])
    @@index([published, createdAt])
    @@map("posts")
}

// model Profile {
//     id  String  @id
