//     user   User @relation(fields: [userId], references: [id])
//     userId Int

//     @@unique([userId])
// }

model Tag {
    id   String @id
    name String

    posts Post[]

    @@unique([name])
}

model Comment {
    id       String   @id
    body     String
    parent   Comment? @relation("Replies", fields: [parentId], references: [id])
    parentId String?

    replies Comment[] @relation("Replies")
}
